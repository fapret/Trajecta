<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="Workspace" nsURI="WorkspaceURI" nsPrefix="WorkspaceURI">
  <eClassifiers xsi:type="ecore:EClass" name="RootWorkspaces">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workspace" upperBound="-1"
        eType="#//WorkspaceElem" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="WorkspaceElem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Password" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="asignaturas" eType="ecore:EClass asignaturas.ecore#//Root"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="estudiante" eType="ecore:EClass estudiante.ecore#//Root"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ID" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
  </eClassifiers>
</ecore:EPackage>
